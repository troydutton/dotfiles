# >>> general >>>
alias l='ls'
alias ll='ls -la'
alias ..='cd ..'
alias ...='cd ../..'
alias :q='exit 0'
alias count='ls -1A | wc -l'
alias src='source ${ZSH_VERSION:+~/.zshrc}${BASH_VERSION:+~/.bashrc}'
alias watch='watch -x bash -ic'
# <<< general <<<
 
# >>> git >>>
if [ -n "$ZSH_VERSION" ]; then
    (( $+functions[compdef] )) || { autoload -Uz compinit && compinit -u; }
    gitcomp() { if [ -n "$2" ]; then compdef _git "$1=git-$2"; else compdef _git "$1=git"; fi; }
elif [ -n "$BASH_VERSION" ] && declare -F __git_complete >/dev/null 2>&1; then
    gitcomp() { if [ -n "$2" ]; then __git_complete "$1" "_git_${2//-/_}"; else __git_complete "$1" __git_main; fi; }
else
    gitcomp() { :; }
fi

alias gs='git status'; gitcomp gs status
alias gd='git diff'; gitcomp gd diff
alias gds='git diff --staged'; gitcomp gds diff
alias ga='git add'; gitcomp ga add
alias gc='git commit'; gitcomp gc commit
alias gp='git push'; gitcomp gp push
alias gf='git fetch'; gitcomp gf fetch
alias gpf='git push --force-with-lease'; gitcomp gpf push
alias gpl='git pull'; gitcomp gpl pull
alias gr='git restore'; gitcomp gr restore
alias gb='git branch -va'; gitcomp gb branch
alias gch='git checkout'; gitcomp gch checkout
alias gl='git log --oneline --graph main..'; gitcomp gl log
alias gpsu='git push --set-upstream origin "$(git symbolic-ref --short HEAD)"'; gitcomp gpsu push
alias gru='git remote update origin --prune'; gitcomp gru remote
alias gpr="git fetch --prune && git branch -vv | grep 'gone]' | awk '{print \$1}' | xargs git branch -D"
alias gw="git worktree"; gitcomp gw worktree
alias gwl="git worktree list"; gitcomp gwl worktree
alias gwa="git worktree add"; gitcomp gwa worktree
alias gwpr="git worktree prune"; gitcomp gwpr worktree
alias dot='git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME'; gitcomp dot
# <<< git <<<

# >>> nvidia-smi >>>
alias nv='nvidia-smi'
alias wnv='watch -n 1 nvidia-smi'
alias nvwho='nvidia-smi --query-compute-apps=pid --format=csv,noheader | xargs -r ps -up'
# <<< nvidia-smi <<<

# >>> conda >>>
alias cda='conda activate'
alias cdd='conda deactivate'
alias cdl='conda list'
alias cdel='conda env list'
# <<< conda <<<

# >>> slurm >>>
alias sq='squeue'
# <<< slurm <<<
