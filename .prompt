# Set chroot
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# Get the active conda environment
conda_env() {
    if [ -n "$CONDA_DEFAULT_ENV" ]; then
        printf "($CONDA_DEFAULT_ENV) "
    fi
}

# Get the active branch
parse_git_branch() {
    local branch=$(git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/')
    if [ -n "$branch" ]; then
        if [ "$1" == "color" ]; then
            printf " on \033[01;36m%s" "$branch"
        else
            printf " on %s" "$branch"
        fi
    fi
}

# Create prompt, e.g.
# ┌ (detr) troy@blade1:~/programs/detr on main
# └ $
PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]┌ $(conda_env)\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]$(parse_git_branch color)\[\033[00m\]\n\[\033[01;32m\]└ \$\[\033[00m\] '
