# Set chroot
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# Prevent venv's activate script from prepending "(.venv) "
export VIRTUAL_ENV_DISABLE_PROMPT=1

# Get the active python environment
python_env() {
    if [ -n "$CONDA_DEFAULT_ENV" ]; then
        printf "(%s) " "$CONDA_DEFAULT_ENV"
    elif [ -n "$VIRTUAL_ENV" ]; then
        printf "(%s) " "$(basename "$VIRTUAL_ENV")"
    fi
}

# Get the active branch
parse_git_branch() {
    local branch=$(git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/')
    if [ -n "$branch" ]; then
        if [ -n "$ZSH_VERSION" ]; then
            printf " on %%{\033[01;36m%%}%s%%{\033[00m%%}" "$branch"
        else
            printf " on \033[01;36m%s\033[00m" "$branch"
        fi
    fi
}

# Get the repository name
parse_git_repo() {
    local common_dir=$(git rev-parse --git-common-dir 2> /dev/null)
    if [ -n "$common_dir" ]; then
        local repo=$(basename "$(dirname "$(cd "$common_dir" && pwd)")")
        if [ -n "$ZSH_VERSION" ]; then
            printf " %%{\033[01;35m%%}[%s]%%{\033[00m%%}" "$repo"
        else
            printf " \033[01;35m[%s]\033[00m" "$repo"
        fi
    fi
}

# Detect active shell and create prompt
if [ -n "$ZSH_VERSION" ]; then
    setopt PROMPT_SUBST
    PS1='${debian_chroot:+($debian_chroot)}%B%F{green}┌ $(python_env)%n@%m%f%b:%B%F{blue}%~%f%b$(parse_git_branch)$(parse_git_repo)
%B%F{green}└ %#%f%b '
elif [ -n "$BASH_VERSION" ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]┌ $(python_env)\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]$(parse_git_branch)$(parse_git_repo)\n\[\033[01;32m\]└ \$\[\033[00m\] '
fi
