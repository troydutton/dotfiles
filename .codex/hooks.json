{
  "description": "Keep the tmux window marker synchronized with Codex lifecycle state.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /Users/troydutton/.agents/codex-tmux-hook.sh",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /Users/troydutton/.agents/codex-tmux-hook.sh",
            "timeout": 1
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /Users/troydutton/.agents/codex-tmux-hook.sh",
            "timeout": 1
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /Users/troydutton/.agents/codex-tmux-hook.sh",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /Users/troydutton/.agents/codex-tmux-hook.sh",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /Users/troydutton/.agents/codex-tmux-hook.sh",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh /Users/troydutton/.agents/codex-tmux-hook.sh",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
